# Copie para .env e ajuste conforme necessário: cp .env.example .env
# Todas as variáveis usam o prefixo INFCAP_ e são validadas no boot —
# um valor inválido derruba o processo na inicialização, nunca em tempo de request.

# local | staging | production
# Em production a documentação interativa (/docs, /openapi.json) fica fora do ar
# e o reload do uvicorn é desligado.
INFCAP_ENVIRONMENT=local

# debug | info | warning | error
INFCAP_LOG_LEVEL=info

# Endereço de bind. Use 0.0.0.0 dentro de container.
INFCAP_HOST=127.0.0.1

# Porta de bind (1-65535).
INFCAP_PORT=8000
